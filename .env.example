# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Google Cloud / Gemini (required) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Path to service account JSON for local dev (keep it OUTSIDE this repo)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Parallel (judged partner integration) ---
PARALLEL_API_KEY=

# --- Storage ---
CONSENTINEL_DB_URL=sqlite:///./data/consentinel.db
# Immutable evidence store. Local path for dev, gs:// bucket in deploy.
CONSENTINEL_EVIDENCE_URI=./evidence

# --- Cache ---
CACHE_DIR=./.cache
CACHE_ENABLED=true
# Run the whole pipeline from cache only — use this while recording the demo
# so a rate limit or flaky API cannot break the take.
DEMO_MODE=false

# --- Prompt versioning ---
# Bump whenever you change an extraction prompt; it is part of the cache key.
PROMPT_VERSION=v1

# --- URL safety (contract v2.0.0, WU-08) ---
# Ask Google Web Risk before opening any third-party page. Fails closed: if the
# check errors, the address is treated as unsafe and skipped. Set to false only
# for local development without the API enabled — fetch_page then logs loudly
# that it went ahead unchecked.
WEB_RISK_ENABLED=true
# Hosts that never enter the pipeline at all (Parallel source_policy).
# Comma-separated. Empty on purpose: an exclusion silently hides findings.
CONSENTINEL_EXCLUDE_DOMAINS=
